      "parameters": {
        "jsCode": "const value = $json.question_KDW1P7.value;\n\nconst urls = Array.isArray(value)\n  ? value\n  : String(value || '')\n      .split(',')\n      .map(u => u.trim())\n      .filter(Boolean);\n\nreturn urls.map(url => ({\n  json: {\n    ...$json,\n    fileUrl: url,\n  },\n}));"
