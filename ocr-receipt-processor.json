      },
      "id": "a6635739-be83-4871-a176-d4e2ac5e5227",
      "name": "Basic LLM Chain4",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1024,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = String($json.text || '').trim();\n\n// Strip ```json ... ``` or ``` ... ``` code fences if present\nlet cleaned = raw\n  .replace(/^```(?:json)?\\s*/i, '')\n  .replace(/```\\s*$/i, '')\n  .trim();\n\nlet data;\ntry {\n  data = JSON.parse(cleaned);\n} catch (e) {\n  // Fallback: extract the first {...} block\n  const match = cleaned.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    data = JSON.parse(match[0]);\n  } else {\n    throw new Error('Could not parse JSON from LLM output: ' + raw);\n  }\n}\n\nreturn [{\n  json: {\n    document_type: data.document_type ?? '',\n    vendor: data.vendor ?? '',\n    date: data.date ?? '',\n    currency: data.currency ?? '',\n    total: data.total ?? '',\n    items: data.items ?? [],\n  },\n}];"
      },
