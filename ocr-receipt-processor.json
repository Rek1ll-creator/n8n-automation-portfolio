    {
      "parameters": {
        "promptType": "define",
        "text": "=Ниже находятся  всех файлов.\n\n{{ $json.text }}\n\nОбъедини их.\n\nУдали дубликаты.\n\nЕсли один документ дополняет другой — объедини данные.\n\nВерни один итоговый JSON без пояснений.",
        "messages": {
          "messageValues": []
        },
